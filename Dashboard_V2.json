    {
        "id": "cd57a240d69a216a",
        "type": "function",
        "z": "1f06ec8faf911fa7",
        "name": "Insert Sensor Data",
        "func": "let d = msg.payload.trim().split(\",\");\n\nlet temperature = parseFloat(d[0]);\nlet humidity = parseFloat(d[1]);\nlet pressure = parseFloat(d[2]);\nlet dust = parseFloat(d[3]);\nlet light = parseFloat(d[4]);\nlet distance = parseFloat(d[5]);\nlet fan = d[6];\n\nlet now = new Date();\n\nlet timestamp =\n    now.getDate() + \"/\" +\n    (now.getMonth() + 1) + \"/\" +\n    now.getFullYear() + \" \" +\n    now.getHours() + \":\" +\n    now.getMinutes() + \":\" +\n    now.getSeconds();\n\nmsg.topic = `\nINSERT INTO Sensor_data\n(Timestamp, temperature, humidity, pressure, dust, light, distance, Fan_Status)\nVALUES\n('${timestamp}', ${temperature}, ${humidity}, ${pressure}, ${dust}, ${light}, ${distance}, '${fan}');\n`;\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 430,
        "y": 180,
        "wires": [
            [
                "739cedaca7fff10b",
                "c4c0b2372f684619"
            ]
