    {
        "id": "9c49df235bf1d073",
        "type": "function",
        "z": "1f06ec8faf911fa7",
        "name": "Sensor Reading",
        "func": "let d = msg.payload.trim().split(\",\");\n\nlet distance = parseFloat(d[5]);\nlet ldr = parseFloat(d[4]);\n\n// determine occupancy\nlet occupancy = (distance >= 100) ? \"NO OCCUPANCY\" : \"OCCUPIED\";\n\n// determine light condition\nlet light = (ldr <= 500) ? \"LOW LIGHT\" : \"NORMAL LIGHT\";\n\nreturn [\n    { payload: parseFloat(d[0]) + \" °C\" },   // Temperature\n    { payload: parseFloat(d[1]) + \" %\" },    // Humidity\n    { payload: parseFloat(d[2]) + \" hPa\" },  // Pressure\n    { payload: parseFloat(d[3]) },           // Dust\n    { payload: distance + \" cm\" },           // Distance\n    { payload: light},                       // Light\n    { payload: d[6] },                       // Fan Status\n    { payload: occupancy }                   // Occupancy Status\n];",
        "outputs": 8,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 400,
        "y": 360,
