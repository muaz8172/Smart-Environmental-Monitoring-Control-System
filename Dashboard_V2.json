    {
        "id": "f18ab2be8e858bb0",
        "type": "function",
        "z": "1f06ec8faf911fa7",
        "name": "Function Chart",
        "func": "let rows = msg.payload;\n\n// function to change your timestamp text into real time\nfunction convertTime(timestamp) {\n    let parts = timestamp.split(\" \");\n    \n    let datePart = parts[0]; // date\n    let timePart = parts[1]; // time\n    \n    let date = datePart.split(\"/\");\n    let time = timePart.split(\":\");\n    \n    let day = Number(date[0]);\n    let month = Number(date[1]) - 1; // month starts from 0\n    let year = Number(date[2]);\n    \n    let hour = Number(time[0]);\n    let minute = Number(time[1]);\n    let second = Number(time[2]);\n    \n    return new Date(year, month, day, hour, minute, second).getTime();\n}\n\n// temperature chart data\nlet tempData = [];\nfor (let i = 0; i < rows.length; i++) {\n    tempData.push({\n        x: convertTime(rows[i].Timestamp),\n        y: Number(rows[i].Temperature)\n    });\n}\n\n// humidity chart data\nlet humData = [];\nfor (let i = 0; i < rows.length; i++) {\n    humData.push({\n        x: convertTime(rows[i].Timestamp),\n        y: Number(rows[i].Humidity)\n    });\n}\n\n// send to 2 chart outputs\nlet msg1 = {\n    payload: [{\n        series: [\"Temperature\"],\n        data: [tempData],\n        labels: [\"\"]\n    }]\n};\n\nlet msg2 = {\n    payload: [{\n        series: [\"Humidity\"],\n        data: [humData],\n        labels: [\"\"]\n    }]\n};\n\nreturn [msg1, msg2];",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 480,
        "y": 660,
        "wires": [
            [
                "103a7b80ddc3e58d"
            ],
            [
                "bf2d9636bc0b33a7"
            ]
        ]
    },
